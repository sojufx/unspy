#!/bin/sh
# 60-debloat-hideapps
# Installed to /var/lib/webosbrew/init.d/ - runs on every boot.
#
# Purpose: neutralise LG ad / overlay / shopping / demo / dev-sample apps that
# cannot be deleted, because /usr and /mnt/otncabi are read-only squashfs
# overlays. This hook bind-mounts an empty directory over each app folder, so the app
# manager finds no appinfo.json and the app can neither be indexed nor launched.
#
# REVERT:
#   rm /var/lib/webosbrew/init.d/60-debloat-hideapps
#   umount /usr/palm/applications/<appid>            (for each hidden app)
#   reboot
#
# Deliberately NOT hidden: the LivePlus / ACR apps (com.webos.app.acr*). Live Plus
# is already "off" and its endpoints are blackholed; hiding them can break the
# Settings > Live Plus toggle for no privacy gain.
#
# Deliberately NOT hidden: com.webos.app.facebooklogin (Thirdparty Login), which
# some streaming apps use for sign-in (you asked to keep those working).

EMPTY=/tmp/debloat-empty
mkdir -p "$EMPTY"

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

APPS="
com.webos.app.adapp
com.webos.app.care365
com.webos.app.dangbei-card
com.webos.app.dangbei-overlay
com.webos.app.shoppinghdmi1
com.webos.app.shoppinghdmi2
com.webos.app.shoppinghdmi3
com.webos.app.shoppinghdmi4
com.webos.app.shoppingoverlay
com.webos.app.store-demo
com.webos.app.sync-demo
com.webos.exampleapp.enyoapp.epg
com.webos.exampleapp.groupowner
com.webos.exampleapp.nav
com.webos.exampleapp.qmlapp.client.negative.one
com.webos.exampleapp.qmlapp.client.negative.two
com.webos.exampleapp.qmlapp.client.positive.one
com.webos.exampleapp.qmlapp.client.positive.two
com.webos.exampleapp.qmlapp.discover
com.webos.exampleapp.qmlapp.epg
com.webos.exampleapp.qmlapp.hbbtv
com.webos.exampleapp.qmlapp.livetv
com.webos.exampleapp.qmlapp.search
com.webos.exampleapp.systemui
google.assistant.promo
"

BASES="/usr/palm/applications /mnt/otncabi/usr/palm/applications"

n=0
for a in $APPS; do
  [ -n "$a" ] || continue
  for b in $BASES; do
    d="$b/$a"
    [ -d "$d" ] || continue
    # idempotent: skip anything already hidden, so repeated runs never stack mounts
    if awk '{print $2}' /proc/mounts 2>/dev/null | grep -qx "$d"; then
      n=$((n+1))
      continue
    fi
    if mount --bind "$EMPTY" "$d" 2>/dev/null; then
      n=$((n+1))
    fi
  done
done

echo "[debloat] hid $n app directories"
