# Copy to tv.env (git-ignored) and edit. Read by scripts/install.sh.
#
# A rooted TV has a telnet root shell (dejavuln / Homebrew Channel) and no SSH,
# so set TV_IP:
TV_IP=192.0.2.10
#
# Or, if your TV has SSH (Developer Mode, or sshd you installed yourself), set
# TV_HOST to an ssh alias or root@<tv-ip> instead:
# TV_HOST=root@192.0.2.10
#
# The telnet path needs no extra software: it uses ../tools/tvpush.py and
# ../tools/tvtelnet.py from this repo (Python 3 standard library only).
